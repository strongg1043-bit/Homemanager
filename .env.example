# ── Gemini / AI Studio ────────────────────────────────────────────────────────
# AI Studio injects GEMINI_API_KEY automatically from user secrets at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: injected automatically by AI Studio with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ── Firebase ───────────────────────────────────────────────────────────────────
# Copy these values from your Firebase project console → Project settings → SDK.
# NEVER commit real values to source control.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
# Project settings → Cloud Messaging → Web configuration → "Generate key pair".
VITE_FIREBASE_VAPID_KEY="YOUR_WEB_PUSH_VAPID_KEY"

# ── Google Play build ──────────────────────────────────────────────────────────
# Kill switch for in-app purchases. Leave unset (or "false") for normal behaviour.
# Set to "true" at build time to hide every price and checkout entry point when the app is
# opened from the Android (Play Store) app. The website and installed PWA are unaffected.
VITE_HIDE_BILLING_IN_ANDROID_APP="false"

# ── EmailJS ────────────────────────────────────────────────────────────────────
# Found in your EmailJS dashboard → Account → API Keys.
VITE_EMAILJS_SERVICE_ID="YOUR_EMAILJS_SERVICE_ID"
VITE_EMAILJS_PUBLIC_KEY="YOUR_EMAILJS_PUBLIC_KEY"
# The reply-to address shown to recipients (your support/contact email).
VITE_EMAILJS_REPLY_TO="your-support@example.com"

# ── Anthropic — Daily Family Quote ─────────────────────────────────────────────
# The API key is now stored SERVER-SIDE as a Firebase Function secret.
# Set it once with: firebase functions:secrets:set ANTHROPIC_API_KEY
# The key is never compiled into the browser bundle.
# The scheduled function (functions/src/index.ts) runs at 06:00 UTC daily.
