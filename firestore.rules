rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function getUser(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isMember(hid) { 
      return isSignedIn() && exists(/databases/$(database)/documents/households/$(hid)) && 
             request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members; 
    }
    function isParent(hid) { 
      return isMember(hid) && getUser(request.auth.uid).role == 'parent';
    }
    function isChild(hid) { 
      return isMember(hid) && getUser(request.auth.uid).role == 'child';
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || (getUser(request.auth.uid).householdId != '' && getUser(request.auth.uid).householdId == resource.data.householdId));
      allow list: if isSignedIn() && resource.data.householdId != '' && resource.data.householdId == getUser(request.auth.uid).householdId;
      
      allow create: if isSignedIn() && request.auth.uid == userId;

      allow update: if isSignedIn() && (
        // Self-update
        (request.auth.uid == userId && (
          // Action: Profile update (display name, household, email sync, avatar, photo)
          (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'householdId', 'email', 'avatarColour', 'profilePhoto'])) ||
          // Action: Point Deduction (Redemption)
          (incoming().diff(existing()).affectedKeys().hasOnly(['totalPoints']) && incoming().totalPoints < existing().totalPoints)
        )) ||
        // Parent update (Task approval or Refund) — only allowed to increase totalPoints (award points).
        // SEC-9: cap the increment to the max allowed task pointValue (10 000) so a parent
        // cannot arbitrarily inflate a child's balance in a single write.
        (getUser(request.auth.uid).role == 'parent' && getUser(request.auth.uid).householdId == existing().householdId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['totalPoints']) &&
         incoming().totalPoints >= existing().totalPoints &&
         incoming().totalPoints - existing().totalPoints <= 10000)
      );
    }

    // --- Households ---
    match /households/{hid} {
      allow get: if isMember(hid);
      allow create: if isSignedIn() && incoming().createdBy == request.auth.uid;
      
      allow update: if isParent(hid) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'familyMotto', 'familyColour', 'familyLogo', 'updatedAt']) ||
        incoming().diff(existing()).affectedKeys().hasAll(['members', 'rewardStore', 'currency', 'currencyName', 'cashOutEnabled', 'minCashOut']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['members']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['rewardStore']) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['currency', 'currencyName', 'cashOutEnabled', 'minCashOut'])
      );

      // --- Tasks ---
      match /tasks/{tid} {
        allow read: if isMember(hid);
        // Require verified email before a parent can create tasks — prevents
        // unverified throwaway accounts from flooding children with tasks.
        allow create: if isVerified() && isParent(hid) && isValidTask(incoming());
        allow update: if isMember(hid) && (
          // Child submitting proof
          (isChild(hid) && existing().assignedTo == request.auth.uid && existing().status in ['pending', 'rejected'] &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'proofPhotoUrl', 'completedAt']) && incoming().status == 'submitted') ||
          // Parent approving/rejecting
          (isParent(hid) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedAt']))
        );
        allow delete: if isParent(hid);
      }

      // --- Redemptions ---
      match /redemptions/{rid} {
        allow read: if isMember(hid);
        // Require verified email before a child can redeem — prevents
        // unverified accounts from initiating financial transactions.
        // SEC-10: Two-layer balance guard —
        //   1. Pre-check: child's current balance must cover the spend (blocks underfunded requests
        //      even when the client omits the points-deduction write from the batch).
        //   2. getAfter: the batch must leave balance >= 0 (catches concurrent double-spends
        //      when both reads see the same starting balance).
        allow create: if isVerified() && isChild(hid) && incoming().childId == request.auth.uid && isValidRedemption(incoming()) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.totalPoints >= incoming().pointsSpent &&
                      getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.totalPoints >= 0;
        allow update: if isParent(hid) && (
          // Action: Approve/Reject/Pay
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedAt', 'paidAt', 'proofPhotoUrl', 'note', 'paidBy', 'paidByName', 'paymentMethod', 'paymentReference', 'paymentNote'])
        );
      }
      
      // --- Notifications ---
      match /notifications/{nid} {
        allow read: if isMember(hid) && existing().recipientId == request.auth.uid;
        allow create: if isMember(hid);
        allow update: if isMember(hid) && existing().recipientId == request.auth.uid && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      }

      // --- Disputes ---
      match /disputes/{did} {
        allow read: if isMember(hid);
        allow create: if isMember(hid);
        allow update: if isParent(hid) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt', 'resolution']);
      }

      // --- Audit Trail ---
      match /audit_trail/{aid} {
        allow read: if isMember(hid);
        allow create: if isMember(hid);
        allow update, delete: if false; // Immutable logs
      }
    }

    // --- Global Settings ---
    // Only parents may write app-wide settings (e.g. email preferences).
    // Children can read so their client can respect e.g. sustainability toggle.
    match /settings/{sid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getUser(request.auth.uid).role == 'parent';
    }

    // --- Suggestions ---
    match /suggestions/{sgid} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    function isValidTask(task) {
      // BUG-3: cap pointValue to 10 000 — prevents "Identity Spoofing" payload #1
      // (child proposes a task with a 1,000,000-point reward).
      return task.title is string && task.title.size() <= 100 &&
             task.pointValue is number && task.pointValue >= 1 && task.pointValue <= 10000 &&
             task.assignedTo is string &&
             task.status == 'pending' &&
             task.householdId is string;
    }

    function isValidRedemption(red) {
      // Require pointsSpent > 0 so children can't create zero-cost redemptions,
      // and cap at 100 000 points (practical upper limit for any child's balance).
      return red.title is string && red.title.size() <= 100 &&
             red.pointsSpent is number && red.pointsSpent >= 1 && red.pointsSpent <= 100000 &&
             red.childId == request.auth.uid &&
             red.status == 'pending' &&
             red.type in ['reward', 'cash'] &&
             red.householdId is string;
    }
  }
}
